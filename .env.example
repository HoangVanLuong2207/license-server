ADMIN_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://license_user:replace-with-a-strong-password@127.0.0.1:5432/license_db
LICENSE_SIGNING_PRIVATE_KEY=base64-encoded-ed25519-private-key

# Shared secret that authorizes AOVshop to issue paid Checkpass keys.
# Must be identical to AOVshop's LICENSE_SERVER_ISSUER_TOKEN.
AOVSHOP_ISSUER_TOKEN=replace-with-a-long-random-secret
